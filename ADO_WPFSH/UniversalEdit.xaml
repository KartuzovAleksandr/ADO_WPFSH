<Window x:Class="ADO_WPFSH.UniversalEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование справочника" Height="500" Width="800" Closing="Window_Closing">
    <Grid Margin="10" KeyDown="Window_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

<!--        CanUserAddRows="True"
                  CanUserDeleteRows="True"
-->        
        <DataGrid x:Name="DataGrid"
                  AutoGenerateColumns="True"
                  AutoGeneratingColumn="DataGrid_OnAutoGeneratingColumn"
                  IsReadOnly="False"
                  Grid.Row="0" 
                  PreviewKeyDown="DataGrid_OnPreviewKeyDown"
                  />
        <Button Content="Сохранить" Click="SaveButton_Click" Grid.Row="1" Width="100" Height="30" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>
